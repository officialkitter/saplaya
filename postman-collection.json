{
  "info": {
    "_postman_id": "saplaya-uber-api",
    "name": "Saplaya Uber-Like Order System",
    "description": "Complete API testing collection for Saplaya backend with 16 endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "📌 Authentication",
      "item": [
        {
          "name": "Login with Supabase",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('auth_token', jsonData.session.access_token);",
                  "    pm.environment.set('user_id', jsonData.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"agent@example.com\",\n  \"password\": \"your-password\"\n}"
            },
            "url": {
              "raw": "https://YOUR-PROJECT.supabase.co/auth/v1/token?grant_type=password",
              "protocol": "https",
              "host": [
                "YOUR-PROJECT",
                "supabase",
                "co"
              ],
              "path": [
                "auth",
                "v1",
                "token"
              ],
              "query": [
                {
                  "key": "grant_type",
                  "value": "password"
                }
              ]
            }
          }
        }
      ]
    },
    {
