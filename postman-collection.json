            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"+254712345678\",\n  \"vehicle_type\": \"motorcycle\",\n  \"vehicle_plate\": \"KBD 123A\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/agents/register",
              "host": [
                "{{base_url}}"
              ],
