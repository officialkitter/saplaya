SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_YOUR-ROTATED-SECRET-KEY
SUPABASE_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json
FIREBASE_PROJECT_ID=saplaya-v1
# Store the Firebase Admin service-account JSON as a Railway secret; never commit it.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Allowed website origins (comma separated) or * while developing
WEB_ORIGIN=*
STORE_LAT=-6.1630
STORE_LNG=35.7516
PESAPAL_ENV=live
PESAPAL_CONSUMER_KEY=your-pesapal-consumer-key
PESAPAL_CONSUMER_SECRET=your-pesapal-consumer-secret
PUBLIC_API_URL=https://YOUR-BACKEND.up.railway.app
PAYMENT_APP_CALLBACK_URL=saplaya://payment-callback
# Set to the deployed website's /checkout/payment URL to enable web Pesapal checkout.
WEB_CHECKOUT_CALLBACK_URL=
# Server-only key restricted to the Google Maps Geocoding API.
GOOGLE_MAPS_API_KEY=

# Explicit live payment-provider configuration.
# Enable live mode only after credentials and webhook delivery are verified.
PAYMENT_ENVIRONMENT=live
PAYMENT_PROVIDERS=paypal,pesapal,snippe
PAYPAL_CLIENT_ID=your_paypal_rest_app_client_id
PAYPAL_CLIENT_SECRET=your_paypal_rest_app_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
PAYPAL_CURRENCIES=USD
PESAPAL_CURRENCIES=TZS
SNIPPE_API_KEY=snp_your_live_api_key
SNIPPE_WEBHOOK_SECRET=whsec_your_live_webhook_signing_key
SNIPPE_CURRENCIES=TZS
# Optional payment profile ID for hosted Snippe checkout branding.
SNIPPE_PROFILE_ID=
