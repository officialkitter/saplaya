SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_YOUR-ROTATED-SECRET-KEY
SUPABASE_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json
FIREBASE_PROJECT_ID=saplaya-v1
# Store the Firebase Admin service-account JSON as a Railway secret; never commit it.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Allowed website origins (comma separated) or * while developing
WEB_ORIGIN=*
STORE_LAT=-6.1630
STORE_LNG=35.7516
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=your-pesapal-consumer-key
PESAPAL_CONSUMER_SECRET=your-pesapal-consumer-secret
PUBLIC_API_URL=https://YOUR-BACKEND.up.railway.app
PAYMENT_APP_CALLBACK_URL=saplaya://payment-callback
# Set to the deployed website's /checkout/payment URL to enable web Pesapal checkout.
WEB_CHECKOUT_CALLBACK_URL=
# Server-only key restricted to the Google Maps Geocoding API.
GOOGLE_MAPS_API_KEY=
